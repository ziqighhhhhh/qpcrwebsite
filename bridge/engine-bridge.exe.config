<?xml version="1.0" encoding="utf-8"?>
<!--
  engine-bridge.exe runtime configuration.

  The original LC96 engine loads its algorithm plug-ins (AlgorithmLibraries\...)
  through Assembly.LoadFrom with a file:// URI. On .NET 4.x a LoadFrom of an
  assembly that the loader resolves through a URI path is rejected with
  NotSupportedException ("attempt to load an assembly from a network location",
  HRESULT 0x80131515) unless loadFromRemoteSources is enabled. Roche ships the
  same switch in LC96.exe.config; the bridge needs its own copy.

  This file must sit next to engine-bridge.exe (lib/engine.js copies both into
  binDir).
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
